{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DomainSchema",
  "type": "object",
  "required": ["name"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "description": { "type": "string" },
    "document_count": { "type": "integer" },
    "created_at": { "type": "string" },
    "metadata": { "type": "object" }
  }
}
