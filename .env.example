# =============================================================================
# Adaptive Domain-Aware RAG - Environment Configuration
# =============================================================================

# Main Node.js Express Gateway
PORT=5000
NODE_ENV=development

# Python AI / RAG Service URL
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_PORT=8000

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Qdrant Vector Database (Cloud or Local)
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=adaptive_domain_rag

# Embedding & Reranker Configuration
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu

# Evidence Gate Parameters
EVIDENCE_CONFIDENCE_THRESHOLD=0.65
TOP_K_CANDIDATES=30
TOP_K_RERANKED=7

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
