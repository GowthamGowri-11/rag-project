{
  "name": "adaptive-domain-aware-rag",
  "version": "1.0.0",
  "private": true,
  "description": "Adaptive Domain-Aware RAG with strict grounding and dynamic domain isolation",
  "scripts": {
    "dev": "concurrently -n \"gateway,frontend\" -c \"blue,cyan\" \"npm run backend\" \"npm run frontend\"",
